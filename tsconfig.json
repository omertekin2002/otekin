{
  // Type-checks the plain JavaScript in bin/, lib/ and test/ against the Node 22 API.
  // Nothing is emitted: the CLI still runs straight from source.
  // test/globals.d.ts declares the `test` global that test/run.js defines.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.js", "lib/**/*.js", "lib/**/*.mjs", "test/**/*.js", "test/**/*.d.ts"]
}
